{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FableLoom Lite",
  "version": "0.5.0",
  "identifier": "dev.fableloom.lite",
  "build": {
    "beforeBuildCommand": "npm run build:frontend:tauri",
    "beforeDevCommand": "npm run build:runtime && npm run dev:web",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "FableLoom",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
