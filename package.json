{
  "name": "storyloom",
  "productName": "StoryLoom",
  "version": "0.6.0",
  "description": "现代化文字游戏编辑器 · 分支叙事 · 节点画布 · 视觉小说播放器（标题画面/快进/音量/存档缩略图） · 发布配置 · 插件系统",
  "main": "out/main/index.js",
  "author": "StoryLoom",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:runtime && electron-vite dev",
    "dev:renderer": "electron-vite dev",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:frontend:tauri": "npm run build:runtime && npm run build:web",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "test:io": "esbuild scripts/io-test.ts --bundle --platform=node --format=esm --outfile=scripts/.io-test.mjs --log-level=warning && node scripts/.io-test.mjs",
    "build:icon": "electron scripts/generate-icon.js",
    "build": "npm run build:runtime && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:core": "node scripts/test-core.mjs",
    "test:studio-app": "esbuild scripts/studio-app-test.ts --bundle --platform=node --format=esm --external:electron --outfile=work/studio-app-test.mjs --log-level=warning && electron work/studio-app-test.mjs",
    "test:app": "esbuild scripts/app-test.ts --bundle --platform=node --format=esm --external:electron --outfile=work/app-test.mjs --log-level=warning && electron work/app-test.mjs",
    "test:player-dom": "electron scripts/player-dom-test.cjs",
    "test:browser-recovery": "electron scripts/browser-recovery-test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@xyflow/react": "^12.8.0",
    "clsx": "^2.1.1",
    "elkjs": "^0.9.0",
    "lucide-react": "^0.544.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
